+// TinyML-Pareto patch (firmware/patches/chirale-2.0.0-int8.patch): integer-only quantized MEAN, ported
+// from TensorFlow 2.18.1 tensorflow/lite/kernels/internal/reference/reduce.h QuantizedMeanOrSum
+// (compute_sum = false). TFLite uses it for every int8/int16 MEAN. Chirale 2.0.0 instead rounds a float
+// mean (1 step off in a few % of elements) or, when input and output quantization are equal, truncates
+// an integer mean.
+template <typename T>
+TfLiteStatus IntegerMeanTf218(TfLiteContext* context, TfLiteNode* node,
+                              OpDataReduce* op_data, int* temp_index,
+                              int* resolved_axis, int32_t* temp_sum) {
+  const TfLiteEvalTensor* input = tflite::micro::GetEvalInput(context, node, 0);
+  const TfLiteEvalTensor* axis = tflite::micro::GetEvalInput(context, node, 1);
+  TfLiteEvalTensor* output = tflite::micro::GetEvalOutput(context, node, 0);
+  const int* input_dims = input->dims->data;
+  const int input_num_dims = input->dims->size;
+  const int* output_dims = output->dims->data;
+  const int output_num_dims = output->dims->size;
+  const T* input_data = tflite::micro::GetTensorData<T>(input);
+  T* output_data = tflite::micro::GetTensorData<T>(output);
+  const int32_t kMinValue = std::numeric_limits<T>::min();
+  const int32_t kMaxValue = std::numeric_limits<T>::max();
+
+  size_t num_outputs = 1;
+  for (int idx = 0; idx < output_num_dims; ++idx) {
+    num_outputs *= static_cast<size_t>(output_dims[idx]);
+  }
+  for (size_t idx = 0; idx < num_outputs; ++idx) {
+    output_data[idx] = T();
+    temp_sum[idx] = 0;
+  }
+  for (int i = 0; i < input_num_dims; ++i) {
+    if (input_dims[i] == 0) return kTfLiteOk;
+  }
+
+  int num_resolved_axis = 0;
+  TF_LITE_ENSURE(context,
+                 reference_ops::ResolveAxis(
+                     input_num_dims, tflite::micro::GetTensorData<int>(axis),
+                     op_data->num_axis, resolved_axis, &num_resolved_axis));
+  TF_LITE_ENSURE(context,
+                 (reference_ops::ReduceSumImpl<T, int32_t>(
+                     input_data, input_dims, output_dims, input_num_dims,
+                     output_num_dims, resolved_axis, num_resolved_axis,
+                     temp_index, temp_sum)));
+
+  int64_t num_elements_in_axis = 1;
+  for (int idx = 0; idx < num_resolved_axis; ++idx) {
+    num_elements_in_axis *= input_dims[resolved_axis[idx]];
+  }
+  if (num_elements_in_axis == 0) return kTfLiteOk;
+
+  // Fold 1/num_elements_in_axis into the output rescaling, as TFLite does. TFLite writes the shift as
+  // 63 - CountLeadingZeros(uint64_t(n)) = floor(log2(n)); Chirale's CountLeadingZeros is 32-bit only
+  // (__builtin_clz for every type), so compute floor(log2(n)) directly.
+  int shift = 0;
+  for (uint64_t v = static_cast<uint64_t>(num_elements_in_axis); v > 1; v >>= 1) {
+    ++shift;
+  }
+  shift = std::min(shift, 32);
+  shift = std::min(shift, 31 + op_data->shift);
+  const int32_t output_multiplier = static_cast<int32_t>(
+      (static_cast<int64_t>(op_data->multiplier) << shift) /
+      num_elements_in_axis);
+  const int output_shift = op_data->shift - shift;
+
+  for (size_t idx = 0; idx < num_outputs; ++idx) {
+    const int32_t shifted_sum = static_cast<int32_t>(
+        temp_sum[idx] - op_data->input_zp * num_elements_in_axis);
+    int32_t out = MultiplyByQuantizedMultiplier(shifted_sum, output_multiplier,
+                                                output_shift) +
+                  op_data->output_zp;
+    out = std::min(std::max(out, kMinValue), kMaxValue);
+    output_data[idx] = static_cast<T>(out);
+  }
+  return kTfLiteOk;
+}
