+// TinyML-Pareto patch: arm_nn_vec_mat_mult_t_s8 (CMSIS-NN 4.0.2, DSP and portable branches) with one
+// requantization (multiplier, shift) per output row, for per-channel int8 dense weights. The per-tensor
+// kernel is what Chirale 2.0.0 used before the patch; the 1x1-convolution path the first patch used is
+// 1.4-2.5x slower for a single input vector.
+void VecMatMultPerChannelS8(const int8_t* lhs, const int8_t* rhs,
+                            const int32_t* bias, int8_t* dst,
+                            const int32_t lhs_offset, const int32_t dst_offset,
+                            const int32_t* dst_multiplier,
+                            const int32_t* dst_shift, const int32_t rhs_cols,
+                            const int32_t rhs_rows, const int32_t act_min,
+                            const int32_t act_max) {
+#if defined(ARM_MATH_DSP) && !defined(ARM_MATH_MVEI)
+  const int32_t row_loop_cnt = rhs_rows / 2;
+  const int16_t lhs_offset_s16 = (int16_t)lhs_offset;
+  const uint32_t lhs_offset_s16x2 =
+      __PKHBT(lhs_offset_s16, lhs_offset_s16, 16);
+  const int32_t col_loop_cnt = rhs_cols / 4;
+
+  for (int32_t i = 0; i < row_loop_cnt; i++) {
+    int32_t acc_0 = 0;
+    int32_t acc_1 = 0;
+    if (bias) {
+      acc_0 = *bias++;
+      acc_1 = *bias++;
+    }
+    const int8_t* lhs_vec = lhs;
+    const int8_t* rhs_0 = rhs;
+    const int8_t* rhs_1 = rhs + rhs_cols;
+    rhs += 2 * rhs_cols;
+
+    for (int32_t j = col_loop_cnt; j != 0; j--) {
+      int32_t vec_0 = arm_nn_read_q7x4_ia(&lhs_vec);
+      int32_t vec_1 =
+          __SXTAB16_RORn(lhs_offset_s16x2, (uint32_t)vec_0, 8);
+      vec_0 = __SXTAB16(lhs_offset_s16x2, vec_0);
+
+      int32_t ker_0 = arm_nn_read_q7x4_ia(&rhs_0);
+      int32_t ker_1 = __SXTB16_RORn((uint32_t)ker_0, 8);
+      ker_0 = __SXTB16(ker_0);
+      acc_0 = __SMLAD(ker_1, vec_1, acc_0);
+      acc_0 = __SMLAD(ker_0, vec_0, acc_0);
+
+      ker_0 = arm_nn_read_q7x4_ia(&rhs_1);
+      ker_1 = __SXTB16_RORn((uint32_t)ker_0, 8);
+      ker_0 = __SXTB16(ker_0);
+      acc_1 = __SMLAD(ker_1, vec_1, acc_1);
+      acc_1 = __SMLAD(ker_0, vec_0, acc_1);
+    }
+    for (int32_t k = col_loop_cnt * 4; k < rhs_cols; k++) {
+      const int32_t lhs_temp = (*lhs_vec + lhs_offset);
+      lhs_vec++;
+      acc_0 += lhs_temp * (*rhs_0);
+      rhs_0++;
+      acc_1 += lhs_temp * (*rhs_1);
+      rhs_1++;
+    }
+    acc_0 = arm_nn_requantize(acc_0, dst_multiplier[0], dst_shift[0]);
+    acc_1 = arm_nn_requantize(acc_1, dst_multiplier[1], dst_shift[1]);
+    dst_multiplier += 2;
+    dst_shift += 2;
+    acc_0 += dst_offset;
+    acc_1 += dst_offset;
+    acc_0 = MAX(acc_0, act_min);
+    acc_0 = MIN(acc_0, act_max);
+    acc_1 = MAX(acc_1, act_min);
+    acc_1 = MIN(acc_1, act_max);
+    dst[0] = (int8_t)acc_0;
+    dst[1] = (int8_t)acc_1;
+    dst += 2;
+  }
+
+  if (rhs_rows & 0x1) {
+    int32_t acc_0 = 0;
+    if (bias) {
+      acc_0 = *bias++;
+    }
+    const int8_t* lhs_vec = lhs;
+    const int8_t* rhs_0 = rhs;
+    for (int32_t j = col_loop_cnt; j != 0; j--) {
+      int32_t vec_0 = arm_nn_read_q7x4_ia(&lhs_vec);
+      int32_t vec_1 =
+          __SXTAB16_RORn(lhs_offset_s16x2, (uint32_t)vec_0, 8);
+      vec_0 = __SXTAB16(lhs_offset_s16x2, vec_0);
+      int32_t ker_0 = arm_nn_read_q7x4_ia(&rhs_0);
+      int32_t ker_1 = __SXTB16_RORn((uint32_t)ker_0, 8);
+      ker_0 = __SXTB16(ker_0);
+      acc_0 = __SMLAD(ker_1, vec_1, acc_0);
+      acc_0 = __SMLAD(ker_0, vec_0, acc_0);
+    }
+    for (int32_t k = col_loop_cnt * 4; k < rhs_cols; k++) {
+      const int32_t lhs_temp = (*lhs_vec + lhs_offset);
+      lhs_vec++;
+      acc_0 += lhs_temp * (*rhs_0);
+      rhs_0++;
+    }
+    acc_0 = arm_nn_requantize(acc_0, dst_multiplier[0], dst_shift[0]);
+    acc_0 += dst_offset;
+    acc_0 = MAX(acc_0, act_min);
+    acc_0 = MIN(acc_0, act_max);
+    dst[0] = (int8_t)acc_0;
+  }
+#else
+  for (int32_t r = 0; r < rhs_rows; r++) {
+    int32_t acc = bias ? bias[r] : 0;
+    const int8_t* rhs_r = rhs + r * rhs_cols;
+    for (int32_t k = 0; k < rhs_cols; k++) {
+      acc += (lhs[k] + lhs_offset) * rhs_r[k];
+    }
+    acc = arm_nn_requantize(acc, dst_multiplier[r], dst_shift[r]);
+    acc += dst_offset;
+    acc = MAX(acc, act_min);
+    acc = MIN(acc, act_max);
+    dst[r] = (int8_t)acc;
+  }
+#endif
+}
