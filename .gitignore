# --- data (never committed; regenerate with ml/prepare_data.py) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
splits/**/*.npy

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/
.pytest_cache/

# --- firmware build output ---
build/
*.elf
*.bin
*.hex
*.map

# --- scratch / dry runs ---
results/dryrun/
*.log

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
firmware/tests/host_sim/bench_sim
firmware/tests/host_sim/bench_sim_cascade
firmware/tests/host_sim/bench_sim_cascade_pu
firmware/tests/host_sim/obj_casc/

# --- generated by tools/bundle.py (regenerate; never edit) ---
firmware/bench/bundle_gen.cpp
firmware/bench/models/
firmware/bench/hann_1024.h
firmware/bench/hann_fx.h
firmware/bench/norm_constants.h
logs/

# --- LaTeX build by-products (paper/main.pdf itself is committed) ---
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.out
paper/*.log

# --- Paderborn run: live status file (rewritten every few seconds) ---
results/pu/progress.json

# --- internal rig data and run logs (kept locally, never published) ---
results/rig/
results/*/hardware/hw_summary.csv

# --- measured cascade: raw rig data stays local; the analysis tables are published ---
results/*/cascade_hw/*
!results/*/cascade_hw/analysis/
